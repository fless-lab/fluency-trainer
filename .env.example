# Copy this file to .env and fill in your key. Never commit .env.

# Speech-to-text provider: "assemblyai" for real use, "mock" to try the app without any key.
STT_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=

# Optional. Comma separated model names sent as "speech_models". Leave empty to use the provider default.
# The AssemblyAI docs list filler word support for universal-3-5-pro and universal-2.
ASSEMBLYAI_SPEECH_MODELS=

# Language model for the feedback after a session. Optional: the app works without it.
# LLM_PROVIDER is "openrouter", "anthropic", or "mock" (fake answers, to try the screen). Leave "none" to disable.
# LLM_MODEL has no default on purpose: put the exact model name from your provider.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
# Optional, only to point at another compatible endpoint.
LLM_BASE_URL=
# Safety cap on feedback requests per day, so a bug or a loop cannot spend your credits.
COACH_MAX_PER_DAY=30

# Model for the voice conversation partner. Optional: falls back to LLM_MODEL. A fast, cheap model
# answers sooner, which matters in a conversation.
LLM_CHAT_MODEL=

# Voice of the conversation partner. "openrouter" (reuses LLM_API_KEY unless TTS_API_KEY is set),
# "openai", "mock" (silence, for tests) or "none" (the browser's own voice is used instead).
TTS_PROVIDER=none
TTS_API_KEY=
# OpenRouter example: google/gemini-3.8-flash-lite-tts with voice Kore (from the OpenRouter docs). The list of
# available voice models is at openrouter.ai/collections/text-to-speech-models and changes: copy a name from there.
TTS_MODEL=
TTS_VOICE=alloy
TTS_BASE_URL=
# Safety cap on spoken characters per day.
TTS_MAX_CHARS_PER_DAY=60000
# Safety cap on partner replies per day (one model call per turn of the conversation).
CHAT_MAX_PER_DAY=400

# Where recordings, transcripts, the database and the event log are stored.
DATA_DIR=./data

HOST=127.0.0.1
PORT=8765

# Pronunciation scores from the audio (Azure Speech, free tier F0 is enough). Leave empty to turn it off.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# The free Azure tier handles one request at a time. With a paid tier you can raise this to score long audio faster.
# PRONUNCIATION_CONCURRENCY=1

# Your first language: the pronunciation lesson compares English sounds with it.
# NATIVE_LANGUAGE=French
